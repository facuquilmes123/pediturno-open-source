# Copy to .env locally. Keep real values in a secret store and out of Git.
# Browser Firebase configuration (public identifiers, not Admin credentials)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_APP_ORIGIN=https://pediturno.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Firebase Admin service account (server only)
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
GCLOUD_CLIENT_EMAIL=
GCLOUD_PRIVATE_KEY_BASE64=

# Email and push (server only)
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_SECURE=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
CRON_SECRET=

# Google Play Billing / Android Publisher (server only). Use either the
# dedicated base64 JSON service account or the existing GCLOUD_* identity
# above; that identity still needs explicit Play Console access.
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_PLAY_MONTHLY_BASE_PLAN_ID=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_BASE64=
GOOGLE_PLAY_RTDN_AUDIENCE=
GOOGLE_PLAY_RTDN_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PLAY_RECONCILE_SECRET=
# Disabled by default. Development-only package allowlist for explicit tests.
GOOGLE_PLAY_ALLOW_TEST_PACKAGES=false
GOOGLE_PLAY_TEST_PACKAGE_NAMES=

# Booking capability delivery: one stable 32-byte base64 key plus a
# separate high-entropy secret for the internal outbox endpoint.
BOOKING_CAPABILITY_OUTBOX_KEY=
BOOKING_OUTBOX_SECRET=

# Mercado Pago: obtain values from the exact live application/account.
MP_ACCESS_TOKEN=
MP_COLLECTOR_ID=
MP_EXPECT_LIVE_MODE=
MP_PAYMENTS_ENABLED=false
NEXT_PUBLIC_MP_PAYMENTS_ENABLED=false
MP_PLATFORM_APPLICATION_ID=
MP_MARKETPLACE_APP_ID=
MP_MARKETPLACE_CLIENT_SECRET=
MP_MARKETPLACE_REDIRECT_URI=
MP_MARKETPLACE_ENABLED=false
MP_MARKETPLACE_EXPECT_LIVE_MODE=false
MP_MARKETPLACE_WEBHOOK_SECRET=
# Optional independent 32-byte base64 key. Otherwise a domain-separated key
# derives from BOOKING_CAPABILITY_OUTBOX_KEY. Keep either source stable.
MP_TOKEN_ENCRYPTION_KEY=
MP_WEBHOOK_SECRET=
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Server-only key for the private account-deletion worker; never send to Android.
ACCOUNT_DELETION_WORKER_KEY=
